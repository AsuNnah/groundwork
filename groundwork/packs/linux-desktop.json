{
  "id": "linux-desktop",
  "title": "Linux desktop app",
  "ui": true,
  "stacks": {
    "gtk": {
      "detect": [
        "meson.build"
      ],
      "ci": "gtk-meson",
      "devcontainer": [
        "gtk",
        "desktop"
      ]
    },
    "qt": {
      "detect": [
        "CMakeLists.txt",
        "*.pro"
      ],
      "ci": "qt-cmake",
      "devcontainer": [
        "qt",
        "desktop"
      ]
    },
    "electron": {
      "detect": [
        "electron-builder.*"
      ],
      "ci": "node",
      "devcontainer": [
        "node",
        "desktop"
      ]
    },
    "tauri": {
      "detect": [
        "src-tauri/tauri.conf.json"
      ],
      "ci": "tauri",
      "devcontainer": [
        "node",
        "rust",
        "tauri-deps",
        "desktop"
      ]
    },
    "flutter": {
      "detect": [
        "pubspec.yaml",
        "linux/"
      ],
      "scaffold": "flutter create --platforms linux {name}",
      "ci": "flutter",
      "devcontainer": [
        "flutter",
        "desktop"
      ]
    }
  },
  "ci": {
    "os": [
      "ubuntu-latest"
    ],
    "vars": {
      "flutter_build": "linux"
    }
  },
  "tools": [
    {
      "id": "git",
      "severity": "block"
    },
    {
      "id": "xvfb",
      "severity": "warn",
      "why": "headless GUI tests"
    }
  ],
  "sandbox": {
    "S1": {
      "needs_any": [
        "containers",
        "gui_tests"
      ],
      "how": "container with Xvfb + noVNC; xdotool/AT-SPI/playwright(electron); screenshot diff"
    },
    "S3": {
      "how": "ubuntu runner with xvfb-run"
    }
  },
  "min_release_tier": "S1",
  "test_tooling": [
    "xvfb-run",
    "dogtail/AT-SPI",
    "playwright (electron)"
  ],
  "release": [
    "AppImage / Flatpak / .deb"
  ],
  "maintain": {
    "electron": {
      "outdated": "npm outdated && npx npm-check-updates",
      "upgrade_safe": "npx npm-check-updates -u --target minor && npm install",
      "upgrade_major": "npx npm-check-updates -u --filter <pkg> && npm install",
      "audit": "npm audit --omit=dev  (or: osv-scanner scan -r .)",
      "deadcode": "npx knip",
      "mutation": "npx --yes -p @stryker-mutator/core@10.0.0 stryker run --testRunner command --mutate 'src/**/*.{js,jsx,ts,tsx}'   # runs your test command against each mutant; slow, run on logic-heavy modules",
      "why_installed": "npm ls <pkg>",
      "override": "package.json \"overrides\" (pnpm: pnpm.overrides, yarn: resolutions)",
      "eol": "nodejs",
      "ecosystem": "node"
    },
    "tauri": {
      "outdated": "cargo outdated -R  (cargo install cargo-outdated)",
      "upgrade_safe": "cargo update",
      "upgrade_major": "cargo upgrade --incompatible  (cargo install cargo-edit; check --help)",
      "audit": "cargo audit  (cargo install cargo-audit)",
      "deadcode": "cargo machete",
      "mutation": "cd src-tauri && cargo mutants   # install: cargo install --locked cargo-mutants",
      "why_installed": "cargo tree -i <crate>",
      "override": "[patch] in Cargo.toml",
      "eol": null,
      "ecosystem": "rust"
    },
    "flutter": {
      "outdated": "flutter pub outdated",
      "upgrade_safe": "flutter pub upgrade",
      "upgrade_major": "flutter pub upgrade --major-versions && dart fix --apply",
      "audit": "osv-scanner scan -r .  (reads pubspec.lock)",
      "deadcode": "dart analyze (unused_* lints)",
      "why_installed": "flutter pub deps",
      "override": "dependency_overrides in pubspec.yaml",
      "eol": null,
      "sdk_upgrade": "flutter upgrade && dart fix --apply",
      "ecosystem": "flutter",
      "codemod": "dart fix --apply"
    }
  },
  "rollback": "Snap: snapcraft release <name> <old-rev> stable (publisher-side revert). Flatpak/AppImage/deb: publish the old code as a higher version.",
  "observe": [
    "crash reporting (Sentry)"
  ],
  "stack_tools": {
    "flutter": [
      {
        "id": "flutter",
        "severity": "block"
      }
    ]
  },
  "policies": [
    {
      "what": "Electron projects: Electron below 43 does not install on Node 26. Its extract-zip step stops part-way and exits 0, so the binary is missing (\"Electron failed to install correctly\"). Use Electron 43+, or pin Node 24 in .nvmrc until you upgrade.",
      "check": "https://releases.electronjs.org/",
      "as_of": "2026-11-06"
    }
  ]
}
