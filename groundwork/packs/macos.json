{
  "id": "macos",
  "title": "macOS desktop app",
  "ui": true,
  "host_only": [
    "macos"
  ],
  "stacks": {
    "swiftui": {
      "detect": [
        "*.xcodeproj"
      ],
      "ci": "xcode"
    },
    "electron": {
      "detect": [
        "electron-builder.*"
      ],
      "ci": "node",
      "devcontainer": [
        "node"
      ]
    },
    "tauri": {
      "detect": [
        "src-tauri/tauri.conf.json"
      ],
      "ci": "tauri",
      "devcontainer": [
        "node",
        "rust",
        "tauri-deps"
      ]
    },
    "flutter": {
      "detect": [
        "pubspec.yaml",
        "macos/"
      ],
      "scaffold": "flutter create --platforms macos {name}",
      "ci": "flutter"
    },
    "dotnet-maui": {
      "detect": [
        "*.csproj with <UseMaui>true</UseMaui>"
      ],
      "scaffold": "dotnet new maui -n {name}",
      "ci": "dotnet-maui"
    },
    "compose-multiplatform": {
      "detect": [
        "**/src/commonMain/kotlin/**"
      ],
      "scaffold": "Kotlin Multiplatform wizard at https://kmp.jetbrains.com (tick the targets you need, Compose Multiplatform for shared UI), or File > New > Kotlin Multiplatform in IntelliJ IDEA / Android Studio",
      "ci": "kmp-desktop"
    }
  },
  "ci": {
    "os": [
      "macos-latest"
    ],
    "vars": {
      "xcode_destination": "platform=macOS",
      "flutter_build": "macos",
      "maui_tfm": "maccatalyst",
      "maui_workload": "maui-maccatalyst"
    }
  },
  "tools": [
    {
      "id": "xcodebuild",
      "severity": "block",
      "host": "macos"
    }
  ],
  "sandbox": {
    "S2": {
      "needs": [
        "build_ios"
      ],
      "how": "native run + XCUITest / Appium Mac2"
    },
    "S3": {
      "how": "GitHub Actions macos runner"
    }
  },
  "min_release_tier": "S3",
  "test_tooling": [
    "XCUITest",
    "playwright (electron)"
  ],
  "release": [
    "Developer ID signing",
    "notarization"
  ],
  "maintain": {
    "swiftui": {
      "outdated": "swift package show-dependencies (SPM has no 'outdated'); pod outdated for CocoaPods",
      "upgrade_safe": "swift package update",
      "upgrade_major": "bump the version requirement in Package.swift, one at a time",
      "audit": "osv-scanner scan -r .",
      "deadcode": "periphery scan",
      "why_installed": "swift package show-dependencies",
      "override": "pin exact version in Package.swift",
      "eol": null,
      "ecosystem": "swift"
    },
    "electron": {
      "outdated": "npm outdated && npx npm-check-updates",
      "upgrade_safe": "npx npm-check-updates -u --target minor && npm install",
      "upgrade_major": "npx npm-check-updates -u --filter <pkg> && npm install",
      "audit": "npm audit --omit=dev  (or: osv-scanner scan -r .)",
      "deadcode": "npx knip",
      "mutation": "npx --yes -p @stryker-mutator/core@10.0.0 stryker run --testRunner command --mutate 'src/**/*.{js,jsx,ts,tsx}'   # runs your test command against each mutant; slow, run on logic-heavy modules",
      "why_installed": "npm ls <pkg>",
      "override": "package.json \"overrides\" (pnpm: pnpm.overrides, yarn: resolutions)",
      "eol": "nodejs",
      "ecosystem": "node"
    },
    "tauri": {
      "outdated": "cargo outdated -R  (cargo install cargo-outdated)",
      "upgrade_safe": "cargo update",
      "upgrade_major": "cargo upgrade --incompatible  (cargo install cargo-edit; check --help)",
      "audit": "cargo audit  (cargo install cargo-audit)",
      "deadcode": "cargo machete",
      "mutation": "cd src-tauri && cargo mutants   # install: cargo install --locked cargo-mutants",
      "why_installed": "cargo tree -i <crate>",
      "override": "[patch] in Cargo.toml",
      "eol": null,
      "ecosystem": "rust"
    },
    "flutter": {
      "outdated": "flutter pub outdated",
      "upgrade_safe": "flutter pub upgrade",
      "upgrade_major": "flutter pub upgrade --major-versions && dart fix --apply",
      "audit": "osv-scanner scan -r .  (reads pubspec.lock)",
      "deadcode": "dart analyze (unused_* lints)",
      "why_installed": "flutter pub deps",
      "override": "dependency_overrides in pubspec.yaml",
      "eol": null,
      "sdk_upgrade": "flutter upgrade && dart fix --apply",
      "ecosystem": "flutter",
      "codemod": "dart fix --apply"
    },
    "dotnet-maui": {
      "outdated": "dotnet list package --outdated",
      "upgrade_safe": "dotnet outdated -u:Auto -vl:Minor (dotnet-outdated-tool)",
      "upgrade_major": "one major at a time; .NET Upgrade Assistant for framework moves",
      "audit": "dotnet list package --vulnerable --include-transitive",
      "deadcode": "IDE0051/IDE0052 analyzers",
      "why_installed": "dotnet nuget why <project> <package>",
      "override": "Directory.Packages.props (central package management)",
      "eol": "dotnet",
      "ecosystem": "nuget"
    }
  },
  "rollback": "App Store: same as iOS. Direct (Sparkle): remove the bad appcast item and publish a higher version; use phased rollout.",
  "observe": [
    "crash reporting (Sentry / Xcode Organizer)"
  ],
  "policies": [
    {
      "what": "Mac App Store uploads follow Apple's yearly Xcode/SDK minimum (Xcode 26 since 2026-04-28).",
      "check": "https://developer.apple.com/news/upcoming-requirements/",
      "as_of": "2026-11-04"
    },
    {
      "what": "Electron projects: Electron below 43 does not install on Node 26. Its extract-zip step stops part-way and exits 0, so the binary is missing (\"Electron failed to install correctly\"). Use Electron 43+, or pin Node 24 in .nvmrc until you upgrade.",
      "check": "https://releases.electronjs.org/",
      "as_of": "2026-11-06"
    }
  ],
  "stack_tools": {
    "flutter": [
      {
        "id": "flutter",
        "severity": "block"
      }
    ],
    "dotnet-maui": [
      {
        "id": "dotnet",
        "min": "9",
        "severity": "block"
      }
    ],
    "compose-multiplatform": [
      {
        "id": "java",
        "min": "17",
        "severity": "block"
      }
    ]
  }
}
