{
  "id": "android",
  "title": "Android app",
  "ui": true,
  "stacks": {
    "kotlin-compose": {
      "detect": [
        "build.gradle.kts",
        "**/AndroidManifest.xml"
      ],
      "scaffold": "Android Studio 'Empty Activity' template or templates from https://github.com/android/architecture-templates"
    },
    "flutter": {
      "detect": [
        "pubspec.yaml"
      ],
      "scaffold": "flutter create --org com.example {name}"
    },
    "react-native": {
      "detect": [
        "app.json",
        "metro.config.*"
      ],
      "scaffold": "npx create-expo-app@latest {name}"
    }
  },
  "tools": [
    {
      "id": "java",
      "min": "17",
      "severity": "block"
    },
    {
      "id": "sdkmanager",
      "severity": "block"
    },
    {
      "id": "adb",
      "severity": "block"
    },
    {
      "id": "emulator",
      "severity": "warn",
      "why": "local UI tests (S2)"
    },
    {
      "id": "maestro",
      "severity": "warn"
    }
  ],
  "stack_tools": {
    "flutter": [
      {
        "id": "flutter",
        "severity": "block"
      }
    ],
    "react-native": [
      {
        "id": "node",
        "min": "20",
        "severity": "block"
      }
    ]
  },
  "sandbox": {
    "S0": {
      "run": "./gradlew test (unit, Robolectric)"
    },
    "S1": {
      "needs": [
        "containers"
      ],
      "how": "gradle build + unit tests in an android-sdk container image"
    },
    "S2": {
      "needs": [
        "android_emulator_local"
      ],
      "how": "headless emulator (-no-window) or budtmo/docker-android; Maestro/Espresso UI tests; or USB device via adb"
    },
    "S3": {
      "how": "GitHub Actions reactivecircus/android-emulator-runner, or Firebase Test Lab"
    }
  },
  "min_release_tier": "S2",
  "test_tooling": [
    "junit",
    "robolectric",
    "espresso",
    "maestro",
    "appium"
  ],
  "release": [
    "AAB signed with upload key (keystore never committed)",
    "Play Console: data safety form, target SDK policy, permissions rationale"
  ],
  "maintain": {
    "kotlin-compose": {
      "outdated": "./gradlew dependencyUpdates (ben-manes plugin)  |  mvn versions:display-dependency-updates",
      "upgrade_safe": "bump patch/minor in gradle/libs.versions.toml",
      "upgrade_major": "OpenRewrite recipe (./gradlew rewriteRun), one major at a time",
      "audit": "osv-scanner scan -r .",
      "deadcode": "IntelliJ inspections / detekt (Kotlin)",
      "why_installed": "./gradlew dependencies --configuration runtimeClasspath",
      "override": "Gradle constraints {} / Maven dependencyManagement",
      "eol": "eclipse-temurin",
      "ecosystem": "java"
    },
    "flutter": {
      "outdated": "flutter pub outdated",
      "upgrade_safe": "flutter pub upgrade",
      "upgrade_major": "flutter pub upgrade --major-versions && dart fix --apply",
      "audit": "osv-scanner scan -r .  (reads pubspec.lock)",
      "deadcode": "dart analyze (unused_* lints)",
      "why_installed": "flutter pub deps",
      "override": "dependency_overrides in pubspec.yaml",
      "eol": null,
      "sdk_upgrade": "flutter upgrade && dart fix --apply",
      "ecosystem": "flutter",
      "codemod": "dart fix --apply"
    },
    "react-native": {
      "outdated": "npm outdated && npx npm-check-updates",
      "upgrade_safe": "npx npm-check-updates -u --target minor && npm install",
      "upgrade_major": "npx npm-check-updates -u --filter <pkg> && npm install",
      "audit": "npm audit --omit=dev  (or: osv-scanner scan -r .)",
      "deadcode": "npx knip",
      "why_installed": "npm ls <pkg>",
      "override": "package.json \"overrides\" (pnpm: pnpm.overrides, yarn: resolutions)",
      "eol": "nodejs",
      "ecosystem": "node",
      "codemod": "npx expo install --fix (Expo) / React Native Upgrade Helper"
    }
  },
  "rollback": "No real rollback. Play Console: Releases > Manage rollout > Halt rollout; ship a fix (or the old code rebuilt) with a HIGHER versionCode. Always staged rollout 1%→5%→20%→50%→100% watching crash-free rate. Remote config / feature flags are the kill switch.",
  "observe": [
    "crash reporting (Firebase Crashlytics or Sentry)",
    "crash-free users ≥ 99.5% before widening a staged rollout",
    "Play Console vitals (ANR rate)"
  ],
  "policies": [
    {
      "what": "Google Play target API level: new apps and updates must target API 36 (Android 16) since 2026-08-31; existing apps below API 35 lose discoverability. Yearly, deadline Aug 31.",
      "check": "https://support.google.com/googleplay/android-developer/answer/11926878",
      "as_of": "2026-11-04"
    }
  ]
}
