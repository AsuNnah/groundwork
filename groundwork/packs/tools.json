{
  "_doc": "Tool catalogue. Keys match host-profile toolchains keys. install: per package manager / method; gw picks the first one available on the host. Never run automatically.",
  "git": {
    "name": "Git",
    "install": {
      "winget": "winget install --id Git.Git -e",
      "brew": "brew install git",
      "apt": "sudo apt install -y git",
      "dnf": "sudo dnf install -y git",
      "pacman": "sudo pacman -S git"
    }
  },
  "gh": {
    "name": "GitHub CLI (needed for CI sandboxes, S3)",
    "install": {
      "winget": "winget install --id GitHub.cli -e",
      "brew": "brew install gh",
      "apt": "sudo apt install -y gh",
      "dnf": "sudo dnf install -y gh"
    }
  },
  "node": {
    "name": "Node.js",
    "install": {
      "mise": "mise use node@22",
      "winget": "winget install --id OpenJS.NodeJS.LTS -e",
      "brew": "brew install node@22",
      "apt": "see https://nodejs.org/en/download (NodeSource) or use mise"
    }
  },
  "python": {
    "name": "Python 3",
    "install": {
      "uv": "uv python install 3.12",
      "winget": "winget install --id Python.Python.3.12 -e",
      "brew": "brew install python@3.12",
      "apt": "sudo apt install -y python3 python3-venv"
    }
  },
  "uv": {
    "name": "uv (Python manager)",
    "install": {
      "winget": "winget install --id astral-sh.uv -e",
      "brew": "brew install uv",
      "any": "curl -LsSf https://astral.sh/uv/install.sh | sh"
    }
  },
  "java": {
    "name": "JDK",
    "install": {
      "mise": "mise use java@temurin-21",
      "winget": "winget install --id EclipseAdoptium.Temurin.21.JDK -e",
      "brew": "brew install --cask temurin@21",
      "apt": "sudo apt install -y openjdk-21-jdk"
    }
  },
  "sdkmanager": {
    "name": "Android SDK command-line tools",
    "install": {
      "any": "Download 'Command line tools only' from https://developer.android.com/studio, unpack to $ANDROID_HOME/cmdline-tools/latest, then: sdkmanager \"platform-tools\" \"platforms;android-35\" \"build-tools;35.0.0\"",
      "brew": "brew install --cask android-commandlinetools"
    }
  },
  "adb": {
    "name": "Android platform-tools (adb)",
    "install": {
      "any": "sdkmanager \"platform-tools\"",
      "brew": "brew install --cask android-platform-tools",
      "apt": "sudo apt install -y adb"
    }
  },
  "emulator": {
    "name": "Android emulator",
    "install": {
      "any": "sdkmanager \"emulator\" \"system-images;android-35;google_apis;x86_64\" (arm64-v8a on ARM hosts)"
    }
  },
  "flutter": {
    "name": "Flutter SDK",
    "install": {
      "mise": "mise use flutter@stable",
      "winget": "see https://docs.flutter.dev/get-started/install/windows",
      "brew": "brew install --cask flutter",
      "any": "git clone https://github.com/flutter/flutter.git -b stable ~/flutter && add ~/flutter/bin to PATH"
    }
  },
  "dotnet": {
    "name": ".NET SDK",
    "install": {
      "winget": "winget install --id Microsoft.DotNet.SDK.8 -e",
      "brew": "brew install --cask dotnet-sdk",
      "apt": "sudo apt install -y dotnet-sdk-8.0",
      "any": "https://dot.net/v1/dotnet-install.sh --channel 8.0"
    }
  },
  "go": {
    "name": "Go",
    "install": {
      "mise": "mise use go@latest",
      "winget": "winget install --id GoLang.Go -e",
      "brew": "brew install go",
      "apt": "sudo apt install -y golang"
    }
  },
  "rustc": {
    "name": "Rust toolchain",
    "install": {
      "any": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
      "winget": "winget install --id Rustlang.Rustup -e"
    }
  },
  "cmake": {
    "name": "CMake",
    "install": {
      "winget": "winget install --id Kitware.CMake -e",
      "brew": "brew install cmake",
      "apt": "sudo apt install -y cmake"
    }
  },
  "gcc": {
    "name": "C/C++ compiler",
    "install": {
      "apt": "sudo apt install -y build-essential",
      "dnf": "sudo dnf groupinstall -y 'Development Tools'",
      "brew": "xcode-select --install",
      "winget": "winget install --id Microsoft.VisualStudio.2022.BuildTools -e"
    }
  },
  "xcodebuild": {
    "name": "Xcode",
    "install": {
      "brew": "Install Xcode from the Mac App Store, then: sudo xcode-select -s /Applications/Xcode.app && xcodebuild -runFirstLaunch"
    }
  },
  "xvfb": {
    "name": "Xvfb (headless display for GUI tests)",
    "install": {
      "apt": "sudo apt install -y xvfb",
      "dnf": "sudo dnf install -y xorg-x11-server-Xvfb",
      "pacman": "sudo pacman -S xorg-server-xvfb"
    }
  },
  "playwright": {
    "name": "Playwright",
    "install": {
      "any": "npm i -D @playwright/test && npx playwright install --with-deps"
    }
  },
  "maestro": {
    "name": "Maestro (mobile UI tests)",
    "install": {
      "any": "curl -fsSL https://get.maestro.mobile.dev | bash"
    }
  },
  "qemu": {
    "name": "QEMU",
    "install": {
      "apt": "sudo apt install -y qemu-system",
      "brew": "brew install qemu",
      "winget": "winget install --id SoftwareFreedomConservancy.QEMU -e"
    }
  },
  "mise": {
    "name": "mise (per-project tool versions)",
    "install": {
      "winget": "winget install --id jdx.mise -e",
      "brew": "brew install mise",
      "any": "curl https://mise.run | sh"
    }
  },
  "docker": {
    "name": "Docker",
    "install": {
      "winget": "winget install --id Docker.DockerDesktop -e",
      "brew": "brew install --cask docker (or colima: brew install colima docker)",
      "apt": "see https://docs.docker.com/engine/install/ubuntu/",
      "dnf": "see https://docs.docker.com/engine/install/fedora/"
    }
  },
  "osv-scanner": {
    "name": "OSV-Scanner (dependency vulnerabilities, all ecosystems)",
    "install": {
      "go": "go install github.com/google/osv-scanner/v2/cmd/osv-scanner@latest",
      "brew": "brew install osv-scanner",
      "winget": "winget install --id Google.OSVScanner -e",
      "any": "download a release binary from https://github.com/google/osv-scanner/releases (verify checksum)"
    }
  },
  "gitleaks": {
    "name": "gitleaks (secret scanning)",
    "install": {
      "brew": "brew install gitleaks",
      "winget": "winget install --id Gitleaks.Gitleaks -e",
      "go": "go install github.com/zricethezav/gitleaks/v8@latest",
      "any": "release binary from https://github.com/gitleaks/gitleaks/releases"
    }
  },
  "syft": {
    "name": "syft (SBOM generator)",
    "install": {
      "brew": "brew install syft",
      "any": "release binary from https://github.com/anchore/syft/releases (verify checksum; avoid curl|sh)"
    }
  },
  "trivy": {
    "name": "Trivy (container image / IaC scanning)",
    "install": {
      "brew": "brew install trivy",
      "apt": "see https://trivy.dev/latest/getting-started/installation/",
      "any": "release binary pinned by checksum; pin the GitHub Action by commit SHA"
    }
  },
  "skillspector": {
    "name": "NVIDIA SkillSpector CLI (static scanner used by skill-inspector)",
    "install": {
      "uv": "uv tool install git+https://github.com/NVIDIA/skillspector.git@62c2fe8622f580ac292d4078c3b71f790194dbbd",
      "any": "install uv first, then: uv tool install git+https://github.com/NVIDIA/skillspector.git@62c2fe8622f580ac292d4078c3b71f790194dbbd"
    }
  }
}