{
  "id": "ios",
  "title": "iOS / iPadOS app",
  "ui": true,
  "host_only": [
    "macos"
  ],
  "stacks": {
    "swiftui": {
      "detect": [
        "*.xcodeproj",
        "Package.swift"
      ],
      "scaffold": "Xcode > New Project > App"
    },
    "flutter": {
      "detect": [
        "pubspec.yaml",
        "ios/"
      ],
      "scaffold": "flutter create {name}"
    },
    "react-native": {
      "detect": [
        "app.json",
        "ios/"
      ],
      "scaffold": "npx create-expo-app@latest {name}"
    }
  },
  "tools": [
    {
      "id": "xcodebuild",
      "severity": "block",
      "host": "macos"
    }
  ],
  "sandbox": {
    "S0": {
      "run": "shared-logic unit tests (any host)"
    },
    "S2": {
      "needs": [
        "build_ios"
      ],
      "how": "xcodebuild test on iOS Simulator; Maestro iOS"
    },
    "S3": {
      "how": "GitHub Actions macos runner, Tart VM on Apple Silicon, or Xcode Cloud"
    }
  },
  "min_release_tier": "S2",
  "non_mac_note": "Cannot build or test iOS UI on Linux/Windows. Develop shared code locally; build + UI-test on a macOS runner (S3).",
  "test_tooling": [
    "XCTest",
    "XCUITest",
    "maestro"
  ],
  "release": [
    "Apple Developer account",
    "signing certificates + provisioning (fastlane match)",
    "App Store privacy labels"
  ],
  "maintain": {
    "swiftui": {
      "outdated": "swift package show-dependencies (SPM has no 'outdated'); pod outdated for CocoaPods",
      "upgrade_safe": "swift package update",
      "upgrade_major": "bump the version requirement in Package.swift, one at a time",
      "audit": "osv-scanner scan -r .",
      "deadcode": "periphery scan",
      "why_installed": "swift package show-dependencies",
      "override": "pin exact version in Package.swift",
      "eol": null,
      "ecosystem": "swift"
    },
    "flutter": {
      "outdated": "flutter pub outdated",
      "upgrade_safe": "flutter pub upgrade",
      "upgrade_major": "flutter pub upgrade --major-versions && dart fix --apply",
      "audit": "osv-scanner scan -r .  (reads pubspec.lock)",
      "deadcode": "dart analyze (unused_* lints)",
      "why_installed": "flutter pub deps",
      "override": "dependency_overrides in pubspec.yaml",
      "eol": null,
      "sdk_upgrade": "flutter upgrade && dart fix --apply",
      "ecosystem": "flutter",
      "codemod": "dart fix --apply"
    },
    "react-native": {
      "outdated": "npm outdated && npx npm-check-updates",
      "upgrade_safe": "npx npm-check-updates -u --target minor && npm install",
      "upgrade_major": "npx npm-check-updates -u --filter <pkg> && npm install",
      "audit": "npm audit --omit=dev  (or: osv-scanner scan -r .)",
      "deadcode": "npx knip",
      "why_installed": "npm ls <pkg>",
      "override": "package.json \"overrides\" (pnpm: pnpm.overrides, yarn: resolutions)",
      "eol": "nodejs",
      "ecosystem": "node",
      "codemod": "npx expo install --fix (Expo) / React Native Upgrade Helper"
    }
  },
  "rollback": "No rollback. Pause phased release (up to 30 days total), ship a fixed build, request expedited review. Remote config / feature flags are the kill switch.",
  "observe": [
    "crash reporting (Crashlytics / Sentry / Xcode Organizer)",
    "crash-free users ≥ 99.5% before releasing phased rollout further"
  ],
  "policies": [
    {
      "what": "App Store uploads must be built with Xcode 26+ / iOS 26 SDK since 2026-04-28; min deployment target iOS 13. Yearly, around April.",
      "check": "https://developer.apple.com/news/upcoming-requirements/",
      "as_of": "2026-11-04"
    }
  ]
}
