{
  "id": "windows",
  "title": "Windows desktop app",
  "ui": true,
  "stacks": {
    "dotnet-wpf-winui": {
      "detect": [
        "*.csproj"
      ],
      "scaffold": "dotnet new wpf -n {name}  (or winui template)"
    },
    "electron": {
      "detect": [
        "electron-builder.*",
        "forge.config.*"
      ],
      "scaffold": "npx create-electron-app@latest {name}"
    },
    "tauri": {
      "detect": [
        "src-tauri/tauri.conf.json"
      ],
      "scaffold": "npm create tauri-app@latest"
    }
  },
  "tools": [
    {
      "id": "git",
      "severity": "block"
    }
  ],
  "stack_tools": {
    "dotnet-wpf-winui": [
      {
        "id": "dotnet",
        "min": "8",
        "severity": "block"
      }
    ],
    "electron": [
      {
        "id": "node",
        "min": "20",
        "severity": "block"
      }
    ],
    "tauri": [
      {
        "id": "node",
        "min": "20",
        "severity": "block"
      },
      {
        "id": "rustc",
        "severity": "block"
      }
    ]
  },
  "sandbox": {
    "S0": {
      "run": "unit tests"
    },
    "S2": {
      "needs_any": [
        "host_windows",
        "kvm_vms"
      ],
      "how": "native on Windows; on Linux: dockur/windows VM (own licence) + FlaUI/pywinauto/Appium NovaWindows"
    },
    "S3": {
      "how": "GitHub Actions windows runner"
    }
  },
  "min_release_tier": "S2",
  "test_tooling": [
    "FlaUI",
    "pywinauto",
    "Appium NovaWindows",
    "playwright (electron)"
  ],
  "release": [
    "MSIX / MSI / winget manifest",
    "Authenticode signing (cert never committed)"
  ],
  "maintain": {
    "dotnet-wpf-winui": {
      "outdated": "dotnet list package --outdated",
      "upgrade_safe": "dotnet outdated -u:Auto -vl:Minor  (dotnet tool install -g dotnet-outdated-tool)",
      "upgrade_major": "edit TargetFramework / package version, one at a time",
      "audit": "dotnet list package --vulnerable --include-transitive",
      "deadcode": "IDE0051/IDE0052 analyzers + dotnet format",
      "mutation": "dotnet stryker   # install: dotnet tool install -g dotnet-stryker",
      "why_installed": "dotnet list package --include-transitive",
      "override": "Directory.Packages.props central version",
      "eol": "dotnet",
      "ecosystem": "dotnet"
    },
    "electron": {
      "outdated": "npm outdated && npx npm-check-updates",
      "upgrade_safe": "npx npm-check-updates -u --target minor && npm install",
      "upgrade_major": "npx npm-check-updates -u --filter <pkg> && npm install",
      "audit": "npm audit --omit=dev  (or: osv-scanner scan -r .)",
      "deadcode": "npx knip",
      "mutation": "npx --yes -p @stryker-mutator/core@10.0.0 stryker run --testRunner command --mutate 'src/**/*.{js,jsx,ts,tsx}'   # runs your test command against each mutant; slow, run on logic-heavy modules",
      "why_installed": "npm ls <pkg>",
      "override": "package.json \"overrides\" (pnpm: pnpm.overrides, yarn: resolutions)",
      "eol": "nodejs",
      "ecosystem": "node"
    },
    "tauri": {
      "outdated": "cargo outdated -R  (cargo install cargo-outdated)",
      "upgrade_safe": "cargo update",
      "upgrade_major": "cargo upgrade --incompatible  (cargo install cargo-edit; check --help)",
      "audit": "cargo audit  (cargo install cargo-audit)",
      "deadcode": "cargo machete",
      "mutation": "cd src-tauri && cargo mutants   # install: cargo install --locked cargo-mutants",
      "why_installed": "cargo tree -i <crate>",
      "override": "[patch] in Cargo.toml",
      "eol": null,
      "ecosystem": "rust"
    }
  },
  "rollback": "Roll forward: publish the previous code as a higher version (MSIX/App Installer, Velopack/Squirrel feed, winget PR). Keep beta and stable channels.",
  "observe": [
    "crash reporting (Sentry minidumps)",
    "update channel adoption"
  ]
}
