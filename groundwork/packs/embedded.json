{
  "id": "embedded",
  "title": "Embedded / firmware",
  "stacks": {
    "zephyr": {
      "detect": [
        "west.yml",
        "prj.conf"
      ],
      "ci": "zephyr",
      "devcontainer": [
        "zephyr"
      ]
    },
    "esp-idf": {
      "detect": [
        "sdkconfig"
      ],
      "ci": "esp-idf",
      "devcontainer": [
        "esp-idf"
      ]
    },
    "platformio": {
      "detect": [
        "platformio.ini"
      ],
      "ci": "platformio",
      "devcontainer": [
        "platformio"
      ]
    }
  },
  "ci": {
    "os": [
      "ubuntu-latest"
    ]
  },
  "tools": [
    {
      "id": "cmake",
      "severity": "block"
    },
    {
      "id": "qemu",
      "severity": "warn",
      "why": "board emulation (S2)"
    }
  ],
  "sandbox": {
    "S0": {
      "run": "host unit tests (Unity/Ceedling, Zephyr native_sim)"
    },
    "S2": {
      "how": "QEMU / Renode board emulation (KVM not required, faster with it)"
    },
    "S3": {
      "how": "hardware-in-the-loop with a real board"
    }
  },
  "min_release_tier": "S3",
  "test_tooling": [
    "Unity/Ceedling",
    "Zephyr Twister",
    "Renode"
  ],
  "release": [
    "signed firmware image",
    "OTA plan"
  ],
  "rollback": "A/B slots with test-then-confirm: MCUboot swap mode + boot_set_confirmed(); ESP-IDF CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE + esp_ota_mark_app_valid_cancel_rollback(); Linux devices RAUC/SWUpdate/Mender. Staged fleet rollout, watchdog, signed images.",
  "observe": [
    "device heartbeat + firmware version reporting",
    "bootcount / rollback events"
  ]
}
